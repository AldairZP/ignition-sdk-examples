{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "editable": {
      "type": "boolean",
      "default": false,
      "description": "Determines whether the events on the calendar can be modified."
    },
    "selectable": {
      "type": "boolean",
      "default": false,
      "description": "Allows a user to highlight multiple days or timeslots by clicking and dragging."
    },
    "selectedDate": {
      "type": "object",
      "description": "The currently selected date",
      "visibleWhen": {
        "property": "selectable",
        "equals": true
      },
      "properties": {
        "start": {
          "type": "string",
          "default": "00:00:00"
        },
        "end": {
          "type": "string",
          "default": "00:00:00"
        }
      }
    },
    "defaultView": {
      "type": "string",
      "suggestions": {
        "Day Grid Month": "dayGridMonth",
        "Day Grid Week": "dayGridWeek",
        "Day Grid Day": "dayGridDay",
        "Time Grid Week": "timeGridWeek",
        "Time Grid Day": "timeGridDay",
        "List Month": "listMonth",
        "List Week": "listWeek",
        "List Day": "listDay"
      },
      "description": "The initial view when the calendar loads.",
      "default": "dayGridMonth"
    },
    "currentView": {
      "type": "string",
      "suggestions": {
        "Day Grid Month": "dayGridMonth",
        "Day Grid Week": "dayGridWeek",
        "Day Grid Day": "dayGridDay",
        "Time Grid Week": "timeGridWeek",
        "Time Grid Day": "timeGridDay",
        "List Month": "listMonth",
        "List Week": "listWeek",
        "List Day": "listDay"
      },
      "description": "The current view being displayed. If written to will attempt to show the view or reset to current view if not possible",
      "default": "dayGridMonth"
    },
    "eventPopUp": {
      "type": "object",
      "properties": {
        "useEventPopUp": {
          "type": "boolean",
          "default": false,
          "description": "Uses the calendar's built in event pop up when an event is clicked"
        },
        "canEditEventOnPopUp": {
          "type": "boolean",
          "default": false,
          "visibleWhen": {
            "property": "useEventPopUp",
            "equals": true
          },
          "description": "Allows the user to edit the event from the default pop up"
        },
        "canExportEventOnPopUp": {
          "type": "boolean",
          "default": false,
          "visibleWhen": {
            "property": "useEventPopUp",
            "equals": true
          },
          "description": "Allows the user to export the event from the default pop up"
        },
        "useCreateEventPopUp": {
          "type": "boolean",
          "default": false,
          "description": "Turns on the built in pop up to create an event when a date/time slot is clicked"
        },
        "canAddOwner": {
          "type": "boolean",
          "default": false,
          "description": "Allows the adding of an owner to the event on the default popups"
        },
        "owners": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Owner"
          },
          "default": [],
          "description": "The list of owners to display in the default popups"
        }
      }
    },
    "events": {
      "type": "array",
      "description": "An array of Event Objects that will be displayed on the calendar.",
      "items": {
        "$ref": "#/definitions/Event"
      },
      "default": []
    },
    "eventDisplay": {
      "type": "object",
      "description": "These properties affect all events on the calendar unless overidden by the event",
      "properties": {
        "eventDisplayType": {
          "type": "string",
          "enum": [
            "auto",
            "block",
            "list-item",
            "background",
            "inverse-background",
            "none"
          ],
          "default": "auto"
        },
        "color": {
          "type": "string",
          "format": "color",
          "default": "",
          "description": "The default color of the event background and border"
        },
        "backgroundColor": {
          "type": "string",
          "format": "color",
          "default": "",
          "description": "The default color of the event background"
        },
        "borderColor": {
          "type": "string",
          "format": "color",
          "default": "",
          "description": "The default color of the event border"
        },
        "font": {
          "type": "object",
          "properties": {
            "textColor": {
              "type": "string",
              "format": "color",
              "default": "#ffffff",
              "description": "The default color of the text on events"
            },
            "weight": {
              "type": "integer",
              "suggestions": {
                "Thin": 100,
                "Light": 300,
                "Regular": 400,
                "Semi Bold": 600,
                "Bold": 700,
                "Heavy": 900
              },
              "default": 400
            },
            "size": {
              "type": "string",
              "default": ""
            },
            "family": {
              "type": "string",
              "default": ""
            }
          }
        },
        "dotEventTextColor": {
          "type": "string",
          "format": "color",
          "default": "#000",
          "description": "The default color of the text on dot events"
        },
        "displayEventTime": {
          "type": "boolean",
          "default": true
        },
        "nextDayThreshold": {
          "type": "string",
          "default": "00:00:00"
        },
        "eventOrder": {
          "type": "string",
          "default": "start,-duration,allDay,title"
        },
        "slotEventOverlap": {
          "type": "boolean",
          "description": "Whether to overlap the events on a day view",
          "default": true
        },
        "showOwner": {
          "type": "boolean",
          "description": "Show the owner name on the event",
          "default": false
        },
        "ownerDivider": {
          "type": "string",
          "description": "The divider between the owner name and the event title",
          "default": " | "
        },
        "eventContentsOrder": {
          "type": "string",
          "enum": [
            "Owner->Title",
            "Title->Owner"
          ],
          "description": "The order of the event and owner name in the event",
          "default": "Owner->Title"
        }
      }
    },
    "currentCalendarDate": {
      "type": "object",
      "description": "The current date being displayed by the calendar",
      "properties": {
        "date": {
          "type": "string",
          "descripion": "An ISO8601 string representation of the current date displayed on the calendar",
          "default": ""
        },
        "dateIsReadOnly": {
          "type": "boolean",
          "description": "If set to true, date property can be used to set the date of the calendar",
          "default": true
        },
        "week": {
          "type": "integer"
        },
        "displayDateStart": {
          "type": "string",
          "default": "",
          "description": "The first date/time being displayed on the calendar"
        },
        "displayDateEnd": {
          "type": "string",
          "default": "",
          "description": "The last date/time being displayed on the calendar"
        },
        "currentDateStart": {
          "type": "string",
          "default": "",
          "description": "The first date/time of the current period being displayed on the calendar"
        },
        "currentDateEnd": {
          "type": "string",
          "default": "",
          "description": "The last date/time of the current period being displayed on the calendar"
        },
        "title": {
          "type": "string",
          "default": "",
          "description": "What is currently being displayed in the title property of the calendar"
        }
      }
    },
    "dateAndTimeDisplay": {
      "type": "object",
      "properties": {
        "firstDay": {
          "$ref": "#/definitions/DayNumber",
          "default": 0,
          "description": "The day that each week begins."
        },
        "minTime": {
          "type": "string",
          "description": "Determines the first time slot that will be displayed for each day.",
          "default": "00:00:00"
        },
        "maxTime": {
          "type": "string",
          "description": "Determines the last time slot that will be displayed for each day.",
          "default": "24:00:00"
        },
        "navLinks": {
          "type": "boolean",
          "default": false,
          "description": "Turns on navigation date links"
        },
        "weekNumbers": {
          "type": "boolean",
          "default": false,
          "description": "Determines if week numbers should be displayed on the calendar."
        },
        "useISOWeekCalc": {
          "type": "boolean",
          "default": true
        },
        "weekLabel": {
          "type": "string",
          "default": "W",
          "description": "What is displayed in front of the week number"
        },
        "nowIndicator": {
          "type": "boolean",
          "default": false,
          "description": "Whether or not to display a marker indicating the current time."
        },
        "todayColor": {
          "type": "string",
          "format": "color",
          "default": "#fcf8e3",
          "description": "The default color of the title on the toolbar"
        },
        "slotDuration": {
          "type": "string",
          "description": "The frequency for displaying time slots.",
          "default": "00:30:00"
        },
        "expandRows": {
          "type": "boolean",
          "description": "If the rows of a given view don’t take up the entire height, they will expand to fit.",
          "default": true
        },
        "snapDuration": {
          "type": [
            "string",
            "boolean"
          ],
          "description": "The frequency for displaying time slots.",
          "default": "00:30:00"
        },
        "slotLabelFormat": {
          "$ref": "#/definitions/DateTimeFormat",
          "default": {
            "hour": "2-digit",
            "minute": "2-digit",
            "meridiem": false,
            "hour12": false
          },
          "description": "The format of the time shown on a time slot"
        },
        "slotLabelInterval": {
          "type": "string",
          "description": "The frequency that the time slots are labeled"
        },
        "allDayText": {
          "type": "string",
          "description": "The text titling the “all-day” slot at the top of the calendar.",
          "default": "All day"
        },
        "weekends": {
          "type": "boolean",
          "default": true,
          "description": "Whether to display weekends"
        },
        "hiddenDays": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/definitions/DayNumber"
          },
          "description": "An array of days to hide from the calendar. 0=Monday, 1=Tuesday, etc."
        },
        "businessHours": {
          "type": [
            "object",
            "array",
            "boolean"
          ],
          "description": "Emphasizes certain time slots on the calendar. Unless overidden, days are Mon-Fri and hours are 9am-5pm",
          "default": false
        },
        "timeZone": {
          "type": "string",
          "suggestions": {
            "Client": "local",
            "Gateway": "gateway",
            "Custom": "custom",
            "(-8) US West Coast": "America/Los_Angeles",
            "(-7) US Mountain": "America/Denver",
            "(-6) US Central": "America/Chicago",
            "(-5) US Eastern": "America/New_York",
            "(-0) UTC": "Etc/UTC",
            "(-0) Western Europe": "WET",
            "(+1) Western Africa": "Africa/Lagos",
            "(+1) Central Europe": "CET",
            "(+2) Central Africa": "Africa/Maputo",
            "(+2) East Europe": "EET",
            "(+3) East Africa": "Africa/Nairobi",
            "(+8) China": "Asia/Shanghai"
          },
          "default": "local"
        },
        "now": {
          "type": "string",
          "visibleWhen": {
            "property": "timeZone",
            "equals": "custom"
          },
          "default": null
        }
      }
    },
    "toolbar": {
      "type": "object",
      "properties": {
        "header": {
          "type": [
            "object",
            "boolean"
          ],
          "properties": {
            "left": {
              "type": "string",
              "default": "dayGridMonth,timeGridWeek,timeGridDay",
              "description": "The left header group"
            },
            "center": {
              "type": "string",
              "default": "title",
              "description": "The center header group"
            },
            "right": {
              "type": "string",
              "default": "today prev,next",
              "description": "The right header group"
            }
          },
          "description": "The structure of the calendar header"
        },
        "footer": {
          "type": [
            "object",
            "boolean"
          ],
          "properties": {
            "left": {
              "type": "string",
              "default": "",
              "description": "The left footer group"
            },
            "center": {
              "type": "string",
              "default": "",
              "description": "The center footer group"
            },
            "right": {
              "type": "string",
              "default": "",
              "description": "The right footer group"
            }
          },
          "default": false,
          "description": "The structure of the calendar footer"
        },
        "title": {
          "type": "object",
          "properties": {
            "rangeSeparator": {
              "type": "string",
              "default": "\u2013",
              "description": "The seperator between two dates/times in the title"
            },
            "font": {
              "type": "object",
              "properties": {
                "textColor": {
                  "type": "string",
                  "format": "color",
                  "default": "#000",
                  "description": "The default color of the title on the toolbar"
                },
                "weight": {
                  "type": [
                    "integer",
                    "string"
                  ],
                  "suggestions": {
                    "Thin": 100,
                    "Light": 300,
                    "Regular": 400,
                    "Semi Bold": 600,
                    "Bold": 700,
                    "Heavy": 900
                  },
                  "default": 400
                },
                "size": {
                  "type": "string",
                  "default": "1.75em"
                },
                "family": {
                  "type": "string",
                  "default": ""
                }
              }
            }
          }
        },
        "buttons": {
          "type": "object",
          "properties": {
            "buttonText": {
              "type": "object",
              "properties": {
                "today": {
                  "type": "string",
                  "default": "today"
                },
                "month": {
                  "type": "string",
                  "default": "month"
                },
                "week": {
                  "type": "string",
                  "default": "week"
                },
                "day": {
                  "type": "string",
                  "default": "day"
                },
                "list": {
                  "type": "string",
                  "default": "list"
                }
              }
            },
            "primary": {
              "$ref": "#/definitions/ToolbarButton",
              "default": {
                "backgroundColor": "#34495e",
                "borderColor": "#34495e",
                "font": {
                  "textColor": "#ffffff",
                  "weight": 400,
                  "size": "",
                  "family": ""
                }
              }
            },
            "hover": {
              "$ref": "#/definitions/ToolbarButton",
              "default": {
                "backgroundColor": "#2c3e50",
                "borderColor": "#2c3e50",
                "font": {
                  "textColor": "#ffffff",
                  "weight": 500,
                  "size": "",
                  "family": ""
                }
              }
            },
            "active": {
              "$ref": "#/definitions/ToolbarButton",
              "default": {
                "backgroundColor": "#2c3e50",
                "borderColor": "#2c3e50",
                "font": {
                  "textColor": "#ffffff",
                  "weight": 400,
                  "size": "",
                  "family": ""
                }
              }
            },
            "customButtons": {
              "type": "object",
              "description": "An object holding descriptions of custom buttons for the toolbars",
              "default": {}
            }
          }
        }
      }
    },
    "viewProperties": {
      "type": "object",
      "properties": {
        "day": {
          "type": "object",
          "properties": {
            "dayHeaderFormat": {
              "$ref": "#/definitions/DateTimeFormat",
              "default": {
                "weekday": "long"
              }
            },
            "titleFormat": {
              "$ref": "#/definitions/DateTimeFormat",
              "default": {
                "year": "numeric",
                "month": "long",
                "day": "numeric"
              }
            }
          }
        },
        "week": {
          "type": "object",
          "properties": {
            "dayHeaderFormat": {
              "$ref": "#/definitions/DateTimeFormat",
              "default": {
                "weekday": "long",
                "month": "numeric",
                "day": "numeric",
                "omitCommas": true
              }
            },
            "titleFormat": {
              "$ref": "#/definitions/DateTimeFormat",
              "default": {
                "year": "numeric",
                "month": "short",
                "day": "numeric"
              }
            }
          }
        },
        "month": {
          "type": "object",
          "properties": {
            "dayHeaderFormat": {
              "$ref": "#/definitions/DateTimeFormat",
              "default": {
                "weekday": "short"
              }
            },
            "titleFormat": {
              "$ref": "#/definitions/DateTimeFormat",
              "default": {
                "year": "numeric",
                "month": "long"
              }
            },
            "fixedWeekCount": {
              "type": "boolean",
              "default": true
            },
            "showNonCurrentDates": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "dayGrid": {
          "type": "object",
          "properties": {
            "dayHeaders": {
              "type": "boolean",
              "default": true
            },
            "eventTimeFormat": {
              "$ref": "#/definitions/DateTimeFormat",
              "default": {
                "hour": "numeric",
                "minute": "2-digit",
                "meridiem": "narrow",
                "omitZeroMinute": true
              }
            }
          }
        },
        "timeGrid": {
          "type": "object",
          "properties": {
            "allDaySlot": {
              "type": "boolean",
              "default": true
            },
            "dayHeaders": {
              "type": "boolean",
              "default": true
            },
            "eventTimeFormat": {
              "$ref": "#/definitions/DateTimeFormat",
              "default": {
                "hour": "numeric",
                "minute": "2-digit",
                "meridiem": false
              }
            }
          }
        },
        "list": {
          "type": "object",
          "properties": {
            "listDayFormat": {
              "$ref": "#/definitions/DateTimeFormat",
              "default": {
                "month": "long",
                "year": "numeric",
                "day": "numeric",
                "weekday": "long"
              },
              "description": "The left hand date format on list views"
            },
            "listDaySideFormat": {
              "type": [
                "object",
                "boolean"
              ],
              "default": false,
              "description": "The right hand date format on list views"
            },
            "noEventsContent": {
              "type": "string",
              "default": "No events to display",
              "description": "The text displayed in the middle of a list view when there are no events in the given range"
            },
            "eventTimeFormat": {
              "$ref": "#/definitions/DateTimeFormat",
              "default": {
                "hour": "numeric",
                "minute": "2-digit",
                "meridiem": "short"
              }
            }
          }
        }
      }
    },
    "popoverProperties": {
      "type": "object",
      "properties": {
        "dayMaxEvents": {
          "type": [
            "boolean",
            "number"
          ],
          "default": false,
          "description": "In, dayGrid view, the max number of events within a given day, not counting the +more link. If true is specified, the number of events will be limited to the height of the day cell."
        },
        "eventMaxStack": {
          "type": "number",
          "description": "For timeGrid view, the maximum number of events that stack left-to-right."
        },
        "dayPopoverFormat": {
          "$ref": "#/definitions/DateTimeFormat",
          "default": {
            "year": "numeric",
            "month": "long",
            "day": "numeric"
          }
        },
        "moreLinkContent": {
          "type": "string",
          "default": "+ more"
        },
        "moreLinkClick": {
          "type": "string",
          "enum": [
            "popover",
            "week",
            "day",
            "dayGridMonth",
            "dayGridWeek",
            "dayGridDay",
            "timeGridWeek",
            "timeGridDay",
            "listMonth",
            "listWeek",
            "listDay"
          ],
          "default": "popover",
          "description": "Determines the action taken when the user clicks on a \"more\" link"
        }
      }
    },
    "longPressDelay": {
      "type": "integer",
      "default": 1000,
      "description": "For touch devices, the amount of time the user most hold down before an event becomes draggable or a date becomes selectable."
    },
    "localeSettings": {
      "type": "object",
      "properties": {
        "locale": {
          "type": "string",
          "suggestions": [
            "ar",
            "ar-dz",
            "ar-kw",
            "ar-ly",
            "ar-ma",
            "ar-sa",
            "ar-tn",
            "bg",
            "ca",
            "cs",
            "da",
            "de",
            "el",
            "en",
            "en-au",
            "en-gb",
            "en-nz",
            "es",
            "es-mx",
            "et",
            "fa",
            "fi",
            "fr",
            "fr-ca",
            "fr-ch",
            "he",
            "hi",
            "hr",
            "hu",
            "id",
            "it",
            "ja",
            "ko",
            "lt",
            "lv",
            "ms",
            "no",
            "nl",
            "pl",
            "pt",
            "ro",
            "ru",
            "sk",
            "sl",
            "sr",
            "sv",
            "th",
            "tr",
            "uk",
            "vi",
            "zh",
            "zh-cn",
            "zh-tw"
          ],
          "default": "en",
          "description": "The locale setting of the calendar"
        },
        "dir": {
          "type": "string",
          "enum": [
            "ltr",
            "rtl",
            "auto"
          ],
          "description": "The direction that elements in the calendar are rendered. Either left-to-right or right-to-left.",
          "default": "ltr"
        }
      }
    },
    "style": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
      "default": {
        "classes": ""
      }
    }
  },
  "definitions": {
    "CalEvent": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "allDay": {
          "type": "boolean"
        },
        "borderColor": {
          "type": "string",
          "format": "color"
        },
        "backgroundColor": {
          "type": "string",
          "format": "color"
        },
        "id": {}
      }
    },
    "DateTimeFormat": {
      "type": "object",
      "properties": {
        "year": {
          "type": "string",
          "enum": [
            "numeric",
            "2-digit"
          ]
        },
        "month": {
          "type": "string",
          "enum": [
            "long",
            "short",
            "narrow",
            "numeric",
            "2-digit"
          ]
        },
        "day": {
          "type": "string",
          "enum": [
            "numeric",
            "2-digit"
          ]
        },
        "weekday": {
          "type": "string",
          "enum": [
            "long",
            "short",
            "narrow"
          ]
        },
        "hour": {
          "type": "string",
          "enum": [
            "numeric",
            "2-digit"
          ]
        },
        "minute": {
          "type": "string",
          "enum": [
            "numeric",
            "2-digit"
          ]
        },
        "second": {
          "type": "string",
          "enum": [
            "numeric",
            "2-digit"
          ]
        },
        "hour12": {
          "type": "boolean"
        },
        "timeZoneName": {
          "type": "string",
          "enum": [
            "short"
          ]
        }
      }
    },
    "DayNumber": {
      "type": "integer",
      "default": 0,
      "suggestions": {
        "Sunday": 0,
        "Monday": 1,
        "Tuesday": 2,
        "Wednesday": 3,
        "Thursday": 4,
        "Friday": 5,
        "Saturday": 6
      }
    },
    "ToolbarButton": {
      "type": "object",
      "properties": {
        "backgroundColor": {
          "type": "string",
          "format": "color",
          "description": "The color of the toolbar button background"
        },
        "borderColor": {
          "type": "string",
          "format": "color",
          "description": "The color of the toolbar button border"
        },
        "font": {
          "type": "object",
          "properties": {
