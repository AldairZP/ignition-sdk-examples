{
    "type": "object",
    "properties": {
        "state": {
            "type": "string",
            "description": "Current interaction mode for the plane.",
            "default": "view",
            "suggestions": {
                "view": "view",
                "create": "create",
                "edit": "edit",
                "delete": "delete"
            }
        },
        "buttons": {
            "type": "boolean",
            "default": true,
            "description": "Show the point action toggles (create/edit/delete) as configurable properties."
        },
        "createPoint": {
            "type": "boolean",
            "default": true,
            "description": "Allow creating new points via click interaction.",
            "visibleWhen": {
                "property": "buttons",
                "equals": true
            }
        },
        "editPoint": {
            "type": "boolean",
            "default": true,
            "description": "Allow selecting and editing existing points.",
            "visibleWhen": {
                "property": "buttons",
                "equals": true
            }
        },
        "deletePoint": {
            "type": "boolean",
            "default": true,
            "description": "Allow deleting existing points.",
            "visibleWhen": {
                "property": "buttons",
                "equals": true
            }
        },
        "panning": {
            "type": "boolean",
            "default": true,
            "description": "Enable panning (drag / keyboard) to move around the plane."
        },
        "zooming": {
            "type": "boolean",
            "description": "Enable zoom interactions (e.g., mouse wheel / gestures).",
            "default": true
        },
        "zoom": {
            "type": "integer",
            "description": "Initial zoom level.",
            "default": 3
        },
        "subdivisions": {
            "type": "integer",
            "description": "Number of grid subdivisions to display.",
            "default": 1,
            "suggestions": {
                "0": 0,
                "1": 1,
                "2": 2,
                "3": 3,
                "4": 4
            }
        },
        "urlImage": {
            "type": "string",
            "description": "URL of the image to display in the component.",
            "default": ""
        },
        "widthImage": {
            "type": "integer",
            "description": "Image width.",
            "default": 10
        },
        "heightImage": {
            "type": "integer",
            "description": "Image height.",
            "default": 10
        },
        "selected-point": {
            "type": "object",
            "description": "Currently selected point (if any).",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Unique identifier for the point."
                },
                "x": {
                    "type": "number",
                    "description": "X coordinate within the plane."
                },
                "y": {
                    "type": "number",
                    "description": "Y coordinate within the plane."
                },
                "color": {
                    "type": "string",
                    "description": "Point color.",
                    "format": "color"
                }
            },
            "default": {}
        },
        "colors": {
            "type": "object",
            "description": "Color configuration for the plane.",
            "minimize": true,
            "properties": {
                "background": {
                    "type": "string",
                    "description": "Background color.",
                    "format": "color",
                    "default": "#000"
                },
                "colorPoints": {
                    "type": "string",
                    "description": "Default color for points.",
                    "format": "color",
                    "default": "#AAADDD"
                },
                "colorEditPoints": {
                    "type": "string",
                    "description": "Color used to highlight points in edit mode.",
                    "format": "color",
                    "default": "#EE00AB"
                },
                "colorDeletePoints": {
                    "type": "string",
                    "description": "Color used to highlight points in delete mode.",
                    "format": "color",
                    "default": "#FF0000"
                },
                "colorLine": {
                    "type": "string",
                    "description": "Grid/line color.",
                    "format": "color",
                    "default": "#333"
                }
            }
        },
        "points": {
            "type": "array",
            "description": "List of points displayed on the plane.",
            "items": {
                "type": "object",
                "description": "A point on the plane.",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the point."
                    },
                    "x": {
                        "type": "number",
                        "description": "X coordinate within the plane."
                    },
                    "y": {
                        "type": "number",
                        "description": "Y coordinate within the plane."
                    },
                    "color": {
                        "type": "string",
                        "description": "Point color.",
                        "format": "color"
                    }
                }
            },
            "default": []
        },
        "style": {
            "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
            "default": {
                "classes": ""
            }
        }
    }
}