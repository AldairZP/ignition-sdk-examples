{
    "type": "object",
    "properties": {
        "buttons": {
            "type": "boolean",
            "default": true,
            "description": "Set true to show the hidden 'conditional' property."
        },
        "panning": {
            "type": "boolean",
            "default": true,
            "description": "Whether to enable panning with the mouse and keyboard"
        },
        "zooming": {
            "type": "boolean",
            "description": "zooming",
            "default": true
        },
        "zoom": {
            "type": "integer",
            "description": "zoom",
            "default": 3
        },
        "urlImage": {
            "type": "string",
            "description": "url of image to display on component.",
            "default": ""
        },
        "widthImage": {
            "type": "integer",
            "description": "width of image",
            "default": 10
        },
        "heightImage": {
            "type": "integer",
            "description": "height of image",
            "default": 10
        },
        "background": {
            "type": "string",
            "description": "color of background",
            "default": "#000"
        },
        "colorPoints": {
            "type": "string",
            "description": "color of points",
            "default": "#fff"
        },
        "colorEditPoints": {
            "type": "string",
            "description": "color of points",
            "default": "#EE00AB"
        },
        "colorDeletePoints": {
            "type": "string",
            "description": "color of points",
            "default": "#FF0000"
        },
        "colorLine": {
            "type": "string",
            "description": "color of lines",
            "default": "#333"
        },
        "subdivisions": {
            "type": "integer",
            "description": "number of subdivisions",
            "default": 1
        },
        "selected-point": {
            "type": "object",
            "description": "selected Point",
            "required": [
                "id",
                "x",
                "y",
                "color"
            ],
            "default": {

            }
        },
        "points": {
            "type": "array",
            "description": "Dynamic array of suggestions to use for another property.",
            "properties": {
                "point": {
                    "type": "object",
                    "description": "point of plane",
                    "required": [
                        "id",
                        "x",
                        "y",
                        "color"
                    ],
                    "default": {
                        "id": "",
                        "x": 0,
                        "y": 0,
                        "color": "#888"
                    }
                }
            },
            "default": []
        },
        "style": {
            "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
            "default": {
                "classes": ""
            }
        }
    }
}