{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "$defs": {
        "embedded_view_config": {
            "type": "object",
            "properties": {
                "viewPath": {
                    "type": "string",
                    "format": "viewParams",
                    "description": "View path of this instance.",
                    "default": ""
                },
                "viewParams": {
                    "type": "object",
                    "description": "Parameters for this instance.",
                    "default": {},
                    "extension": {
                        "view-params": {
                            "path": "../viewPath"
                        }
                    }
                },
                "viewStyle": {
                    "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
                    "default": {
                        "classes": ""
                    }
                },
                "viewPosition": {
                    "type": "object",
                    "description": "Instance position properties.",
                    "default": {},
                    "properties": {
                        "grow": {
                            "type": "number",
                            "description": "Flex grow property."
                        },
                        "shrink": {
                            "type": "number",
                            "description": "Flex shrink property."
                        },
                        "basis": {
                            "type": [
                                "number",
                                "string"
                            ],
                            "description": "Flex basis property."
                        },
                        "align": {
                            "type": "string",
                            "description": "Align self property.",
                            "enum": [
                                "auto",
                                "flex-start",
                                "flex-end",
                                "center",
                                "baseline",
                                "stretch"
                            ]
                        }
                    }
                },
                "useDefaultHeight": {
                    "type": "boolean",
                    "description": "Use default view height."
                },
                "useDefaultMinHeight": {
                    "type": "boolean",
                    "description": "Use default minimum view height."
                },
                "useDefaultMinWidth": {
                    "type": "boolean",
                    "description": "Use default minimum view height."
                },
                "useDefaultWidth": {
                    "type": "boolean",
                    "description": "Use default view width."
                }
            }
        }
    },
    "properties": {
        "instances": {
            "type": "array",
            "description": "Array of view instances.",
            "default": [],
            "items": {
                "$ref": "#/$defs/embedded_view_config"
            }
        },
        "instanceCommon": {
            "$ref": "#/$defs/embedded_view_config",
            "description": "Properties shared between all view instances.",
            "default": {
                "viewParams": {},
                "viewStyle": {
                    "classes": ""
                },
                "viewPosition": {
                    "grow": 0,
                    "shrink": 0,
                    "basis": "auto"
                }
            }
        },
        "settings": {
            "type": "object",
            "properties": {
                "direction": {
                    "type": "string",
                    "description": "Direction of layout of repeated views.",
                    "default": "row",
                    "enum": [
                        "row",
                        "row-reverse",
                        "column",
                        "column-reverse"
                    ]
                },
                "wrap": {
                    "type": "string",
                    "description": "Whether the container should allow repeated views to wrap to next line if space has run out.",
                    "default": "nowrap",
                    "enum": [
                        "nowrap",
                        "wrap",
                        "wrap-reverse"
                    ]
                },
                "justify": {
                    "type": "string",
                    "description": "Adjust placement of repeated views along the main axis when there is extra space, which may be used to fill areas before, after, or in-between.",
                    "default": "flex-start",
                    "enum": [
                        "flex-start",
                        "flex-end",
                        "center",
                        "space-between",
                        "space-around",
                        "space-evenly"
                    ]
                },
                "alignItems": {
                    "type": "string",
                    "description": "Adjusts placement of repeated views along the cross axis when there is extra space.",
                    "default": "stretch",
                    "enum": [
                        "flex-start",
                        "flex-end",
                        "center",
                        "baseline",
                        "stretch"
                    ]
                },
                "alignContent": {
                    "type": "string",
                    "description": "Adjust alignment of repeated views when there is free space in the cross axis.",
                    "default": "stretch",
                    "enum": [
                        "flex-start",
                        "flex-end",
                        "center",
                        "space-between",
                        "space-around",
                        "stretch"
                    ]
                }
            }
        },
        "buttons": {
            "type": "string",
            "format": "viewParams",
            "description": "Set true to show the hidden 'conditional' property."
        },
        "createPoint": {
            "type": "boolean",
            "default": true,
            "description": "Whether to enable point creation on click"
        },
        "panning": {
            "type": "boolean",
            "default": true,
            "description": "Whether to enable panning with the mouse and keyboard"
        },
        "zooming": {
            "type": "boolean",
            "description": "zooming",
            "default": true
        },
        "zoom": {
            "type": "integer",
            "description": "zoom",
            "default": 3
        },
        "subdivisions": {
            "type": "integer",
            "description": "number of subdivisions",
            "default": 1,
            "suggestions": {
                "0": 0,
                "1": 1,
                "2": 2,
                "3": 3,
                "4": 4
            }
        },
        "urlImage": {
            "type": "string",
            "description": "url of image to display on component.",
            "default": ""
        },
        "widthImage": {
            "type": "integer",
            "description": "width of image",
            "default": 10
        },
        "heightImage": {
            "type": "integer",
            "description": "height of image",
            "default": 10
        },
        "selected-point": {
            "type": "object",
            "description": "selected Point",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Unique identifier for the point."
                },
                "x": {
                    "type": "number",
                    "description": "X coordinate within the plane."
                },
                "y": {
                    "type": "number",
                    "description": "Y coordinate within the plane."
                },
                "color": {
                    "type": "string",
                    "description": "color of point",
                    "format": "color"
                }
            },
            "default": {}
        },
        "colors": {
            "type": "object",
            "description": "All about colors",
            "minimize": true,
            "properties": {
                "background": {
                    "type": "string",
                    "description": "color of background",
                    "format": "color",
                    "default": "#000"
                },
                "colorPoints": {
                    "type": "string",
                    "description": "color of points",
                    "format": "color",
                    "default": "#AAADDD"
                },
                "colorEditPoints": {
                    "type": "string",
                    "description": "color of points",
                    "format": "color",
                    "default": "#EE00AB"
                },
                "colorDeletePoints": {
                    "type": "string",
                    "description": "color of points",
                    "format": "color",
                    "default": "#FF0000"
                },
                "colorLine": {
                    "type": "string",
                    "description": "color of lines",
                    "format": "color",
                    "default": "#333"
                }
            }
        },
        "points": {
            "type": "array",
            "description": "Dynamic array of suggestions to use for another property.",
            "items": {
                "type": "object",
                "description": "point of plane",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the point."
                    },
                    "x": {
                        "type": "number",
                        "description": "X coordinate within the plane."
                    },
                    "y": {
                        "type": "number",
                        "description": "Y coordinate within the plane."
                    },
                    "color": {
                        "type": "string",
                        "description": "color of point",
                        "format": "color"
                    }
                }
            },
            "default": []
        },
        "style": {
            "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
            "default": {
                "classes": ""
            }
        }
    },
    "required": [
        "instances",
        "settings"
    ]
}