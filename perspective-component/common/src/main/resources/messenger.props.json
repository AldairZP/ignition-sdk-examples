{
    "type": "object",
    "properties": {
        "buttons": {
            "type": "boolean",
            "default": true,
            "description": "Set true to show the hidden 'conditional' property."
        },
        "createPoint": {
            "type": "boolean",
            "default": true,
            "description": "Whether to enable point creation on click",
            "visibleWhen": {
                "property": "Buttons",
                "equals": true
            }
        },
        "editPoint": {
            "type": "boolean",
            "default": true,
            "description": "Whether to enable point creation on click",
            "visibleWhen": {
                "property": "Buttons",
                "equals": true
            }
        },
        "deletePoint": {
            "type": "boolean",
            "default": true,
            "description": "Whether to enable point creation on click",
            "visibleWhen": {
                "property": "Buttons",
                "equals": true
            }
        },
        "panning": {
            "type": "boolean",
            "default": true,
            "description": "Whether to enable panning with the mouse and keyboard"
        },
        "zooming": {
            "type": "boolean",
            "description": "zooming",
            "default": true
        },
        "zoom": {
            "type": "integer",
            "description": "zoom",
            "default": 3
        },
        "subdivisions": {
            "type": "integer",
            "description": "number of subdivisions",
            "default": 1,
            "suggestions": {
                "0": 0,
                "1": 1,
                "2": 2,
                "3": 3,
                "4": 4
            }
        },
        "urlImage": {
            "type": "string",
            "description": "url of image to display on component.",
            "default": ""
        },
        "widthImage": {
            "type": "integer",
            "description": "width of image",
            "default": 10
        },
        "heightImage": {
            "type": "integer",
            "description": "height of image",
            "default": 10
        },
        "selected-point": {
            "type": "object",
            "description": "selected Point",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Unique identifier for the point."
                },
                "x": {
                    "type": "number",
                    "description": "X coordinate within the plane."
                },
                "y": {
                    "type": "number",
                    "description": "Y coordinate within the plane."
                },
                "color": {
                    "type": "string",
                    "description": "color of point",
                    "format": "color"
                }
            },
            "default": {}
        },
        "colors": {
            "type": "object",
            "description": "All about colors",
            "minimize": true,
            "properties": {
                "background": {
                    "type": "string",
                    "description": "color of background",
                    "format": "color",
                    "default": "#000"
                },
                "colorPoints": {
                    "type": "string",
                    "description": "color of points",
                    "format": "color",
                    "default": "#AAADDD"
                },
                "colorEditPoints": {
                    "type": "string",
                    "description": "color of points",
                    "format": "color",
                    "default": "#EE00AB"
                },
                "colorDeletePoints": {
                    "type": "string",
                    "description": "color of points",
                    "format": "color",
                    "default": "#FF0000"
                },
                "colorLine": {
                    "type": "string",
                    "description": "color of lines",
                    "format": "color",
                    "default": "#333"
                }
            }
        },
        "points": {
            "type": "array",
            "description": "Dynamic array of suggestions to use for another property.",
            "items": {
                "type": "object",
                "description": "point of plane",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the point."
                    },
                    "x": {
                        "type": "number",
                        "description": "X coordinate within the plane."
                    },
                    "y": {
                        "type": "number",
                        "description": "Y coordinate within the plane."
                    },
                    "color": {
                        "type": "string",
                        "description": "color of point",
                        "format": "color"
                    }
                }
            },
            "default": []
        },
        "style": {
            "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
            "default": {
                "classes": ""
            }
        }
    }
}