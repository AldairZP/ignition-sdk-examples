{
  "type": "object",
  "required": [
    "style"
  ],
  "additionalProperties": false,
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "allowZoom": {
          "type": "boolean",
          "description": "Enable or disable zooming in place.",
          "default": true
        },
        "allowPan": {
          "type": "boolean",
          "description": "Enable or disable panning in place.",
          "default": true
        },
        "allowTouchEvents": {
          "type": "boolean",
          "description": "Enables touch event propagation.",
          "default": true
        },
        "doubleTouchMaxDelay": {
          "type": "number",
          "description": "Max delay between two taps to consider a double tap (in milliseconds)",
          "default": 300
        },
        "fitOnMount": {
          "type": "boolean",
          "description": "Whether to fit the inner container to the outer container on mount.",
          "default": false
        },
        "fitOnMountInstantly": {
          "type": "boolean",
          "description": "Whether to override the default transition to fit instantly on mount",
          "visibleWhen": {
            "property": "fitOnMount",
            "equals": true
          },
          "default": false
        },
        "defaultTransitionDuration": {
          "type": "string",
          "description": "The default transition duration (in css format).",
          "default": "0.25s"
        },
        "defaultTimingFunction": {
          "type": "string",
          "description": "The default timing function for the transitions",
          "suggestions": [
            "ease",
            "ease-in",
            "ease-out",
            "ease-in-out",
            "linear",
            "step-start",
            "step-end"
          ],
          "default": "ease-out"
        },
        "alwaysDrawAllChildren": {
          "type":"boolean",
          "desription": "When true, all children are drawn even when off screen",
          "default": false
        },
        "inDebugMode": {
          "type": "boolean"
        },
        "debug": {
          "type": "object",
          "visibleWhen": {
            "property": "inDebugMode",
            "equals": true
          },
          "properties": {
            "showDebugQueue": {
              "type": "boolean"
            },
            "debugQueueSize": {
              "type": "number"
            },
            "showDebugBorders": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "innerWidth": {
          "type": "number",
          "description": "The width of the inner XY container in pixels.",
          "default": 1000
        },
        "innerHeight": {
          "type": "number",
          "description": "The height of the inner XY container in pixels.",
          "default": 1000
        },
        "initialPosition": {
          "type": "object",
          "description": "The initial position of the inner container.",
          "properties": {
            "x": {
              "type": "number",
              "default": 0
            },
            "y": {
              "type": "number",
              "default": 0
            }
          }
        },
        "initialScale": {
          "type": "number",
          "description": "",
          "default": 1
        }
      }
    },
    "currentState": {
      "type": "object",
      "description": "The current state of the scale and translate properties",
      "properties": {
        "scale": {
          "type": "number",
          "description": "The current scale factor",
          "default": 1
        },
        "posX": {
          "type": "number",
          "description": "The current translation distance on the X axis",
          "default": 0
        },
        "posY": {
          "type": "number",
          "description": "The current translation distance on the Y axis",
          "default": 0
        }
      }
    },
    "minScale": {
      "type": "number",
      "description": "The minimum scale level for the container.",
      "default": 1
    },
    "maxScale": {
      "type": "number",
      "description": "The maximum scale level for the container.",
      "default": 5
    },
    "scrollVelocity": {
      "type": "number",
      "description": "The zoom increment or decrement on each scroll wheel detection.",
      "default": 0.2
    },
    "useVelocityForTouchZoom": {
      "type": "boolean",
      "description": "Whether to use a velocity value for touch zoom",
      "default": true
    },
    "touchZoomVelocity": {
      "type": "number",
      "description": "The zoom increment or decrement when zooming with touch controls",
      "default": 0.2
    },
    "showToolbox": {
      "type": "boolean",
      "description": "Whether to show the toolbox on the zoom pan container"
    },
    "innerStyle": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
      "default": {
        "classes": ""
      }
    },
    "style": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
      "default": {
        "classes": "",
        "overflow": "hidden"
      }
    }
  },
  "events": [
    {
      "name": "onScaleChanged",
      "description": "Fires when the scale changes",
      "scehma": {
        "type": "object",
        "properties": {
          "newScale": {
            "type": "number",
            "description": "The new scale factor"
          }
        }
      }
    },
    {
      "name": "onPositionChanged",
      "description": "Fires when the position changes",
      "scehma": {
        "type": "object",
        "properties": {
          "newX": {
            "type": "number",
            "description": "The new x position"
          },
          "newY": {
            "type": "number",
            "description": "The new y position"
          }
        }
      }
    },
    {
      "name": "onDoubleTap",
      "description": "Fires on a double tap",
      "scehma": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "description": "The x location of the second tap in the double tap"
          },
          "y": {
            "type": "number",
            "description": "The y location of the second tap in the double tap"
          }
        }
      }
    },
    {
      "name": "onWindowResize",
      "description": "Fires when the browser window resizes",
      "scehma": {
        "type": "object",
        "properties": {
          "w": {
            "type": "number",
            "description": "New window width"
          },
          "h": {
            "type": "number",
            "description": "New window height"
          }
        }
      }
    }
  ]
}