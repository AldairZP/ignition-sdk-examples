{
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "icon": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string",
                    "format": "icon-path",
                    "default": "material/notifications"
                },
                "size": {
                            "type": "number",
                            "default": "100%"
                },
                "color": {
                            "type": "string",
                            "format": "color",
                            "default": "#000"
                        }
                    },
            "default": {
                    "path": "material/notifications",
                    "size": "100%",
                    "color": "#000"
            }
        },
        "number": {
            "type": "number",
             "description": "number of notification.",
             "default": 2
                },
        "max": {
            "type": "number",
            "description": "max of notification or alarm number.",
            "default": 100
        },
        "color": {
            "type": "string",
            "description": "Theme of color",
            "enum": [
                "error",
                "secondary",
                "default",
                "primary"
            ],
            "default": "error"
        },
        "visible": {
                "type": "boolean",
                "description": "isVisible?",
                "enum": [
                    true,
                    false],
                "default": true

        },
        "position": {
            "type": "string",
            "description": "Position of notification or Alarm ",
            "enum": [
                "Top-Right",
                "Top-Left",
                "Bottom-Right",
                "Bottom-Left"
            ],
            "default":"Top-Right"
        },
        "isDot": {
            "type": "boolean",
            "description": "isDot?",
            "enum": [
                true,
                false],
            "default": false
        },
        "style": {
            "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
            "default": {
                "classes": ""
            }
        }
    }
}